end
item: Custom Dialog Set
  Name=Save Old Installation?
  item: Dialog
    Title=Save Old Installation?
    Width=131
    Height=91
    Font Name=Helv
    Font Size=8
    item: Static
      Rectangle=5 5 110 46
      Create Flags=01010000000000000000000000000000
      Text=I found an old installation of the 3.0 plugin. Should I save this installation? You might want me to if you modified configuration parameters in it.
    end
    item: Push Button
      Rectangle=6 55 41 70
      Variable=SAVEIT
      Value=Yes
      Action=1
      Create Flags=01010000000000010000000000000001
      Text=Yes
    end
    item: Push Button
      Rectangle=85 55 120 70
      Action=3
      Create Flags=01010000000000010000000000000000
      Text=Abort
    end
    item: Push Button
      Rectangle=45 55 80 70
      Variable=SAVEIT
      Value=No
      Action=1
      Create Flags=01010000000000010000000000000000
      Text=No
    end
  end
end
item: If/While Statement
  Variable=SAVEIT
  Value=Yes
end
item: Display Message
  Title=Saving Old Installation
  Text=I am saving these older files in %MAINDIR%\%MOVETARGET%. After this installation is finished, you may merge your changes into the new installation and then you can safely delete the directory %MAINDIR%\%MOVETARGET%.
end
item: Copy Local File
  Source=%VERDIR%\*
  Destination=%MAINDIR%\%MOVETARGET%
  Description=Savng Files From Older Installation
  Flags=0000000101000010
end
item: Delete File
  Pathname=%VERDIR%
  Flags=00001000
end
item: End Block
end
item: End Block
end
