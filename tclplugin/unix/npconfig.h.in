#ifndef NP_CONFIG
#define NP_CONFIG

/*
 * Define to empty if the keyword does not work. 
 */

#undef const

/*
 * Define PLUGIN_TRACE to have the wrapper functions print
 * messages to stderr whenever they are called.
 */

#undef PLUGIN_TRACE

/*
 * Define if you have the <unistd.h> header file.
 */

#undef HAVE_UNISTD_H

/*
 * Below this point are inserted by configure the version number
 * informations and the endif NP_CONFIG (coming from npconfig.post.in)
 */
