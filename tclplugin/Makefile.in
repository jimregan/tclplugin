# Makefile.in --
#
# Makefile for Tcl browser plugin
#
# RCS:  @(#) $Id$
#

#========================================================================
# The names of the source files is defined in the configure script.
# The object files are used for linking into the final library.
# This will be used when a dist target is added to the Makefile.
# It is not important to specify the directory, as long as it is the
# $(srcdir) or in the generic, win or unix subdirectory.
#========================================================================

WIN_OBJECTS	= npWin.$(OBJEXT) npWinPlat.$(OBJEXT) npdll32.res
UNIX_OBJECTS	= npUnixPlat.$(OBJEXT) npUnix.$(OBJEXT)

PKG_SOURCES	= @PKG_SOURCES@
PKG_OBJECTS	= @PKG_OBJECTS@ \
		  npInit.$(OBJEXT) npTcl.$(OBJEXT) npInterp.$(OBJEXT) \
		  npToken.$(OBJEXT) npCmds.$(OBJEXT) npLog.$(OBJEXT) \
		  npStream.$(OBJEXT)

PKG_STUB_SOURCES = @PKG_STUB_SOURCES@
PKG_STUB_OBJECTS = @PKG_STUB_OBJECTS@

#========================================================================
# PKG_TCL_SOURCES identifies Tcl runtime files that are associated with
# this package that need to be installed, if any.
#========================================================================

PKG_TCL_SOURCES = @PKG_TCL_SOURCES@

#========================================================================
# This is a list of public header files to be installed, if any.
#========================================================================

PKG_HEADERS	= @PKG_HEADERS@

#========================================================================
# "PKG_LIB_FILE" refers to the library (dynamic or static as per
# configuration options) composed of the named objects.
#========================================================================

PKG_LIB_FILE	= @PKG_LIB_FILE@
PKG_STUB_LIB_FILE = @PKG_STUB_LIB_FILE@

lib_BINARIES	= $(PKG_LIB_FILE)
BINARIES	= $(lib_BINARIES)

SHELL		= @SHELL@

srcdir		= @srcdir@
prefix		= @prefix@
exec_prefix	= @exec_prefix@

bindir		= @bindir@
libdir		= @libdir@
datadir		= @datadir@
mandir		= @mandir@
includedir	= @includedir@

DESTDIR		=

PKG_DIR		= $(PACKAGE_NAME)$(PACKAGE_VERSION)
pkgdatadir	= $(datadir)/$(PKG_DIR)
pkglibdir	= $(libdir)/$(PKG_DIR)
pkgincludedir	= $(includedir)/$(PKG_DIR)

top_builddir	= .

INSTALL		= @INSTALL@
INSTALL_PROGRAM	= @INSTALL_PROGRAM@
INSTALL_DATA	= @INSTALL_DATA@
INSTALL_SCRIPT	= @INSTALL_SCRIPT@

PACKAGE_NAME	= @PACKAGE_NAME@
PACKAGE_VERSION	= @PACKAGE_VERSION@
CC		= @CC@
CFLAGS_DEFAULT	= @CFLAGS_DEFAULT@
CFLAGS_WARNING	= @CFLAGS_WARNING@
CLEANFILES	= @CLEANFILES@
EXEEXT		= @EXEEXT@
LDFLAGS_DEFAULT	= @LDFLAGS_DEFAULT@
MAKE_LIB	= @MAKE_LIB@
MAKE_SHARED_LIB	= @MAKE_SHARED_LIB@
MAKE_STATIC_LIB	= @MAKE_STATIC_LIB@
MAKE_STUB_LIB	= @MAKE_STUB_LIB@
OBJEXT		= @OBJEXT@
RANLIB		= @RANLIB@
RANLIB_STUB	= @RANLIB_STUB@
SHLIB_CFLAGS	= @SHLIB_CFLAGS@
SHLIB_LD	= @SHLIB_LD@
SHLIB_LD_LIBS	= @SHLIB_LD_LIBS@
STLIB_LD	= @STLIB_LD@
TCL_DEFS	= @TCL_DEFS@
TCL_BIN_DIR	= @TCL_BIN_DIR@
TCL_SRC_DIR	= @TCL_SRC_DIR@
# Not used by sample, but retained for reference of what Tcl required
TCL_LIBS	= @TCL_LIBS@

TCL_LIB_FILE	= @TCL_LIB_FILE@
LIB_RUNTIME_DIR	= @LIB_RUNTIME_DIR@

#========================================================================
# TCLLIBPATH seeds the auto_path in Tcl's init.tcl so we can test our
# package without installing.  The other environment variables allow us
# to test against an uninstalled Tcl.  Add special env vars that you
# require for testing here (like TCLX_LIBRARY).
#========================================================================

EXTRA_PATH	= $(top_builddir):$(TCL_BIN_DIR)
TCLSH_ENV	= TCL_LIBRARY=`@CYGPATH@ $(TCL_SRC_DIR)/library` \
		  @LD_LIBRARY_PATH_VAR@="$(EXTRA_PATH):$(@LD_LIBRARY_PATH_VAR@)" \
		  PATH="$(EXTRA_PATH):$(PATH)" \
		  TCLLIBPATH="$(top_builddir)"
TCLSH_PROG	= @TCLSH_PROG@
WISH_PROG	= @WISH_PROG@
TCLSH		= $(TCLSH_ENV) $(TCLSH_PROG)
WISH		= $(TCLSH_ENV) $(WISH_PROG)

INCLUDES	= @PKG_INCLUDES@ @TCL_INCLUDES@

PKG_CFLAGS	= @PKG_CFLAGS@

DEFS		= @DEFS@ $(PKG_CFLAGS) \
		  -DLIB_RUNTIME_DIR=\"${LIB_RUNTIME_DIR}\" \
		  -DTCL_LIB_FILE=\"${TCL_LIB_FILE}\"

CONFIG_CLEAN_FILES = Makefile

CPPFLAGS	= @CPPFLAGS@
LIBS		= @PKG_LIBS@ @LIBS@
AR		= @AR@
CFLAGS		= @CFLAGS@
COMPILE		= $(CC) $(DEFS) $(INCLUDES) $(CPPFLAGS) $(CFLAGS)

# The top, architecture dependent directory for installation
# (in general this is your MOZILLA_HOME directory)
INST_TOP	= @MOZILLA_DIR@

# Destination directory : for the plugin shared lib
NSP_DESTDIR	= $(INST_TOP)/plugins

#========================================================================
# Start of user-definable TARGETS section
#========================================================================

all: binaries libraries doc

binaries: $(BINARIES)

libraries:

doc:

install: all install-libraries install-binaries install-doc

install-binaries: binaries
	@echo "Installing plugin binary to $(DESTDIR)$(NSP_DESTDIR)"
	@mkdir -p $(DESTDIR)$(NSP_DESTDIR)
	@$(INSTALL_PROGRAM) $(PKG_LIB_FILE) $(DESTDIR)$(NSP_DESTDIR)
	@echo "Verify data in $(DESTDIR)$(pkglibdir)/installed.cfg"
	@echo "     set ::plugin(executable) to latest 8.4 wish binary"
	@echo "set ::plugin(executable) {`@CYGPATH@ $(WISH_PROG)`}" \
		>> $(DESTDIR)$(pkglibdir)/installed.cfg

install-libraries: libraries
	@echo "Installing plugin runtime libraries to $(DESTDIR)$(pkglibdir)"
	@list='. config safetcl utils'; for p in $$list; do \
	  mkdir -p $(DESTDIR)$(pkglibdir)/$$p; \
	  for i in `ls -dr $(srcdir)/library/$$p/*.* 2>/dev/null`; do \
	    $(INSTALL_DATA) $$i $(DESTDIR)$(pkglibdir)/$$p/; \
	  done \
	done
	@$(INSTALL_DATA) $(srcdir)/license.terms $(DESTDIR)$(pkglibdir)

install-doc: doc

# Piping to cat is necessary on Windows to see the output, and
# harmless on Unix
test: binaries libraries
	$(WISH) `@CYGPATH@ $(srcdir)/tests/all.tcl` $(TESTFLAGS) | cat

shell: binaries libraries
	@$(WISH) $(SCRIPT)

depend:

#========================================================================
# $(PKG_LIB_FILE) should be listed as part of the BINARIES variable
# mentioned above.  That will ensure that this target is built when you
# run "make binaries".
#
# The $(PKG_OBJECTS) objects are created and linked into the final
# library.  In most cases these object files will correspond to the
# source files above.
#========================================================================

$(PKG_LIB_FILE): $(PKG_OBJECTS)
	-rm -f $(PKG_LIB_FILE)
	${MAKE_LIB}
	$(RANLIB) $(PKG_LIB_FILE)

$(PKG_STUB_LIB_FILE): $(PKG_STUB_OBJECTS)
	-rm -f $(PKG_STUB_LIB_FILE)
	${MAKE_STUB_LIB}
	$(RANLIB_STUB) $(PKG_STUB_LIB_FILE)

VPATH = $(srcdir):$(srcdir)/generic:$(srcdir)/unix:$(srcdir)/win

.SUFFIXES: .c .cpp .rc .res .$(OBJEXT)

.c.@OBJEXT@:
	$(COMPILE) -c `@CYGPATH@ $<` -o $@

.cpp.$(OBJEXT):
	$(COMPILE) -c `@CYGPATH@ $<` -o $@

.rc.res:
	rc.exe -fo $@ -r -i $(INCLUDES) $(DEFS) `@CYGPATH@ $<`

dist:
	DESTDIR=/tmp/tclplugin$(PACKAGE_VERSION)/
	@$(INSTALL_SCRIPT) $(srcdir)/tools/install.tcl $(DESTDIR)
	@$(INSTALL_PROGRAM) $(PKG_LIB_FILE) $(DESTDIR)
	@list='. config safetcl utils'; for p in $$list; do \
	  mkdir -p $(DESTDIR)$(PKG_DIR)/$$p; \
	  for i in `ls -dr $(srcdir)/library/$$p/*.* 2>/dev/null`; do \
	    $(INSTALL_DATA) $$i $(DESTDIR)$(PKG_DIR)/$$p/; \
	  done \
	done
	@$(INSTALL_DATA) $(srcdir)/license.terms $(DESTDIR)$(PKG_DIR)

#========================================================================
# Don't modify the file to clean here.  Instead, set the "CLEANFILES"
# variable in configure.in
#========================================================================

clean:  
	-test -z "$(BINARIES)" || rm -f $(BINARIES)
	-rm -f *.$(OBJEXT) core *.core
	-test -z "$(CLEANFILES)" || rm -f $(CLEANFILES)

distclean: clean
	-rm -f *.tab.c
	-rm -f $(CONFIG_CLEAN_FILES)
	-rm -f config.cache config.log config.status

Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	cd $(top_builddir) \
	  && CONFIG_FILES=$@ CONFIG_HEADERS= $(SHELL) ./config.status

AUTOCONF	= autoconf
GTAR		= gtar

#dist: distsave distclean sdist
#	cp save/config.status .
#	sh ./config.status

alldist: dist dgz

dgz:
	(cd $(DISTDIRTOP); $(RM) $(DISTRIB_SRC).tar.gz ; $(GTAR) cvfz $(DISTRIB_SRC).tar.gz $(DISTDIRNAME))
	(cd $(DISTDIRTOP); $(RM) $(DISTRIB_SRC).zip; zip -r9 $(DISTRIB_SRC).zip $(DISTDIRNAME))
	@echo "### $(DISTRIB_SRC).tar.gz and .zip created."

.PHONY: all binaries clean depend distclean doc install libraries test

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:

# DO NOT DELETE THIS LINE -- make depend depends on it.
