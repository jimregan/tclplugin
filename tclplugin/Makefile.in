#
# Makefile for Tcl/Tk plugin
#
# RCS:  @(#) $Id$
#

#  plugWinMain.$(OBJEXT) npdll32.res
WIN_OBJECTS	= npWin.$(OBJEXT) npWinPlat.$(OBJEXT) npWinDll.$(OBJEXT) \
		  npdll32.res
UNIX_OBJECTS	= npUnixPlat.$(OBJEXT) npUnix.$(OBJEXT)

nptcl_OBJECTS	= npInit.$(OBJEXT) npTcl.$(OBJEXT) npInterp.$(OBJEXT) \
		  npToken.$(OBJEXT) npCmds.$(OBJEXT) npLog.$(OBJEXT) \
		  npStream.$(OBJEXT) @EXTRA_OBJECTS@
nptcl_LIB_FILE	= @nptcl_LIB_FILE@

#========================================================================
# RUNTIME_SOURCES identifies Tcl runtime files that are associated with
# this package that need to be installed, if any.
#========================================================================

RUNTIME_SOURCES	= 

PKG_MAN_PAGES	= 

#========================================================================
# This is a list of header files to be installed
#========================================================================

GENERIC_HDRS	= 

#========================================================================
# Add additional lines to handle any additional AC_SUBST cases that
# have been added to the configure script.
#========================================================================

PKG_EXTRA_FILES = 

#========================================================================
# The variable "$(PACKAGE)_LIB_FILE" is the parameterized name of the
# library that we are building.
#========================================================================

lib_BINARIES	= $($(PACKAGE)_LIB_FILE)
BINARIES	= $(lib_BINARIES)

SHELL		= @SHELL@

srcdir		= @srcdir@
prefix		= @prefix@
exec_prefix	= @exec_prefix@

bindir		= @bindir@
libdir		= @libdir@
datadir		= @datadir@
mandir		= @mandir@
includedir	= @includedir@

DESTDIR		=

PKG_DIR		= $(PACKAGE)$(VERSION)
pkgdatadir	= $(datadir)/$(PKG_DIR)
pkglibdir	= $(libdir)/$(PKG_DIR)
pkgincludedir	= $(includedir)/$(PKG_DIR)

top_builddir	= .

INSTALL		= @INSTALL@
INSTALL_PROGRAM	= @INSTALL_PROGRAM@
INSTALL_DATA	= @INSTALL_DATA@
INSTALL_SCRIPT	= @INSTALL_SCRIPT@

#========================================================================
# TCLLIBPATH seeds the auto_path in Tcl's init.tcl so we can test our
# package without installing.  The other environment variables allow us
# to test against an uninstalled Tcl.  Add special env vars that you
# require for testing here (like TCLX_LIBRARY).
#========================================================================

EXTRA_PATH	= $(top_builddir):$(TCL_BIN_DIR):$(TK_BIN_DIR)
TCLSH_ENV	= TCL_LIBRARY=`@CYGPATH@ $(TCL_SRC_DIR)/library` \
		  TK_LIBRARY=`@CYGPATH@ $(TK_SRC_DIR)/library` \
		  LD_LIBRARY_PATH="$(EXTRA_PATH):$(LD_LIBRARY_PATH)" \
		  LIBPATH="$(EXTRA_PATH):${LIBPATH}" \
		  SHLIB_PATH="$(EXTRA_PATH):${SHLIB_PATH}" \
		  PATH="$(EXTRA_PATH):$(PATH)" \
		  TCLLIBPATH="$(top_builddir)"
TCLSH_PROG	= @TCLSH_PROG@
WISH_PROG	= @WISH_PROG@
TCLSH		= $(TCLSH_ENV) $(TCLSH_PROG)
WISH		= $(TCLSH_ENV) $(WISH_PROG)

GENERIC_DIR	= "`@CYGPATH@ $(srcdir)/generic`"
PLAT_DIR	= @PLAT_DIR@
# The local includes must come first, because the TK_XINCLUDES can be
# just a comment
INCLUDES	= -I. -I$(GENERIC_DIR) \
		  @TCL_INCLUDES@ @TK_INCLUDES@ @TK_XINCLUDES@

PACKAGE		= @PACKAGE@
VERSION		= @VERSION@
CC		= @CC@
CFLAGS_DEBUG	= @CFLAGS_DEBUG@
CFLAGS_DEFAULT	= @CFLAGS_DEFAULT@
CFLAGS_OPTIMIZE	= @CFLAGS_OPTIMIZE@
CLEANFILES	= @CLEANFILES@
EXEEXT		= @EXEEXT@
LDFLAGS_DEBUG	= @LDFLAGS_DEBUG@
LDFLAGS_DEFAULT	= @LDFLAGS_DEFAULT@
LDFLAGS_OPTIMIZE = @LDFLAGS_OPTIMIZE@
MAKE_LIB	= @MAKE_LIB@
MAKE_SHARED_LIB	= @MAKE_SHARED_LIB@
MAKE_STATIC_LIB	= @MAKE_STATIC_LIB@
OBJEXT		= @OBJEXT@
RANLIB		= @RANLIB@
SHLIB_CFLAGS	= @SHLIB_CFLAGS@
SHLIB_LD	= @SHLIB_LD@
SHLIB_LDFLAGS	= @SHLIB_LDFLAGS@
SHLIB_LD_LIBS	= @SHLIB_LD_LIBS@
STLIB_LD	= @STLIB_LD@
TCL_DEFS	= @TCL_DEFS@
TCL_SRC_DIR	= @TCL_SRC_DIR@
TCL_BIN_DIR	= @TCL_BIN_DIR@
TK_SRC_DIR	= @TK_SRC_DIR@
TK_BIN_DIR	= @TK_BIN_DIR@

# Not used by sample, but retained for reference of what Tcl required
TCL_LIBS	= @TCL_LIBS@
TK_LIBS		= @TK_LIBS@

EXTRA_CFLAGS	= $(MEM_DEBUG_FLAGS) @EXTRA_CFLAGS@

DEFS		= $(TCL_DEFS) @DEFS@ $(EXTRA_CFLAGS) \
		  -DTCL_LIB_FILE=\"@TCL_LIB_FILE@\"

CONFIG_CLEAN_FILES = Makefile

CPPFLAGS	= @CPPFLAGS@
LIBS		= @LIBS@
AR		= ar
CFLAGS		= @CFLAGS@
COMPILE		= $(CC) $(DEFS) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) $(AM_CFLAGS) $(CFLAGS)

# ln -s (needed)
LN_S		= @LN_S@

# The top, architecture dependent directory for installation
# (in general this is your MOZILLA_HOME directory)
INST_TOP	= @MOZILLA_DIR@

# Destination directory : for the plugin shared lib
NSP_DESTDIR	= $(INST_TOP)/plugins

# Destination directory : for the external tcl process (server)
BIN_DIR		= $(INST_TOP)/tclplug
# Alternate possibility:
#BIN_DIR	= $(exec_prefix)/bin

# Destination directory : for the plugin librarie files
# Nb: If you change this to something different from $MOZILLA_HOME/tclplug,
#     /usr/local/lib/netscape/tclplug or $HOME/tclplug you will need to
#     set the TCL_PLUGIN_DIR environment var to this dir so the plugin
#     can find it.
PLUG_DESTROOT	= $(INST_TOP)/tclplug

# Where to find installed libraries (for lean lib version)
LIB_RUNTIME_DIR	=  $(exec_prefix)/lib

# Plugin lib file name (with version and OS dependant shared lib extension)
NSP_LIB_FILE	= @NSP_LIB_FILE@

#========================================================================
# Start of user-definable TARGETS section
#========================================================================

# Distributions name
DISTRIB_ROOT_NAME	= nptcl@NPTCL_DISTRIB_NAME@
DISTRIB_NAME	= $(DISTRIB_ROOT_NAME)-$(DISTRIB)
DISTRIB_SRC	= $(DISTRIB_ROOT_NAME)-src

# Staging directory, default subdirectory of build directory
STAGEDIR	= $(DISTRIB_NAME)
# Archive file
STAGEFILE	= $(DISTRIB_NAME).tar.gz

# Dist dir (likely to be SunScript specific target anyway)
# (use make alldist DISTDIRTOP=wherever)
DISTDIRTOP	= /proj/tcl/dist

# should not be changed
DISTDIRNAME	= nptcl@NPTCL_PATCH_LEVEL@
DISTDIR1	= $(DISTDIRTOP)/$(DISTDIRNAME)
DISTDIR2	= $(DISTDIRTOP)/$(DISTDIRNAME)/plugin$(VERSION)

# ******************************** Stop ************************************
# no changes should be needed below...
STAGING		= 0
DISTRIB		= unknown
PLUG_TOP_DEST	= $(PLUG_DESTROOT)/$(VERSION)
NPL_DESTDIR	= $(PLUG_TOP_DEST)/plugin
NPL_ICONF	= installed.cfg
NPUTIL_DESTDIR	= $(PLUG_TOP_DEST)/utils
NPCFG_DESTDIR	= $PLUG_TOP_DEST)/config
#NPPOLICY_DESTDIR	= $(PLUG_TOP_DEST)/policies
#NPTRUST_DESTDIR	= $(PLUG_TOP_DEST)/trust
NPFEATURES_DESTDIR	= $(PLUG_TOP_DEST)/safetcl
NPDOC_DESTDIR	= $(PLUG_TOP_DEST)/doc
NPTCL_DESTDIR	= $(PLUG_TOP_DEST)/tcl
NPTK_DESTDIR	= $(PLUG_TOP_DEST)/tk

TARGETS		= $(NSP_LIB_FILE) $(TCLSHP)

all: binaries libraries doc

binaries: $(BINARIES) pkgIndex.tcl

libraries:

doc:

install: all install-binaries install-libraries install-doc

install-binaries: binaries
	@echo "place $($(PACKAGE)_LIB_FILE) in browser plugins directory"
	@echo "edit $(DESTDIR)$(pkglibdir)/installed.cfg"
	@echo "     set ::plugin(executable) to latest 8.4 wish binary"
	@echo "     set ::plugin(sharedLibraryDir) as necessary"

install-libraries: libraries
	@echo "Installing plugin libraries to $(DESTDIR)$(pkglibdir)"
	@list='. config safetcl utils'; for p in $$list; do \
	  mkdir -p $(DESTDIR)$(pkglibdir)/$$p; \
	  for i in `ls -dr $(srcdir)/library/$$p/*.* 2>/dev/null`; do \
	    $(INSTALL_DATA) $$i $(DESTDIR)$(pkglibdir)/$$p/; \
	  done \
	done
	@$(INSTALL_DATA) $(srcdir)/license.terms $(DESTDIR)$(pkglibdir)

install-doc: doc

# Piping to cat is necessary on Windows to see the output, and
# harmless on Unix
test: binaries libraries
	$(WISH) `@CYGPATH@ $(srcdir)/tests/all.tcl` $(TESTFLAGS) | cat

shell: binaries libraries
	@$(WISH) $(SCRIPT)

depend:

#========================================================================
# $($(PACKAGE)_LIB_FILE) should be listed as part of the BINARIES variable
# mentioned above.  That will ensure that this target is built when you
# run "make binaries".
#
# The $($(PACKAGE)_OBJECTS) objects are created and linked into the final
# library.  In most cases these object files will correspond to the
# source files above.
#========================================================================

$($(PACKAGE)_LIB_FILE): $($(PACKAGE)_OBJECTS)
	-rm -f $($(PACKAGE)_LIB_FILE)
	${MAKE_LIB}
	$(RANLIB) $($(PACKAGE)_LIB_FILE)

VPATH = $(srcdir)/generic:$(srcdir)/unix:$(srcdir)/win

.SUFFIXES: .c .cpp .rc .res .$(OBJEXT)

.c.$(OBJEXT):
	$(COMPILE) -c `@CYGPATH@ $<` -o $@

.cpp.$(OBJEXT):
	$(COMPILE) -c `@CYGPATH@ $<` -o $@

.rc.res:
	rc.exe -fo $@ -r -i $(INCLUDES) @DEFS@ `@CYGPATH@ $<`

pkgIndex.tcl:
	(\
	echo 'if {[catch {package require Tcl 8.2}]} return';\
	echo 'package ifneeded $(PACKAGE) $(VERSION) \
	    [list load [file join $$dir $($(PACKAGE)_LIB_FILE)] $(PACKAGE)]'\
	) > pkgIndex.tcl

#========================================================================
# Don't modify the file to clean here.  Instead, set the "CLEANFILES"
# variable in configure.in
#========================================================================

clean:  
	-test -z "$(BINARIES)" || rm -f $(BINARIES)
	-rm -f *.$(OBJEXT) core *.core
	-test -z "$(CLEANFILES)" || rm -f $(CLEANFILES)

distclean: clean
	-rm -f *.tab.c
	-rm -f $(CONFIG_CLEAN_FILES)
	-rm -f config.cache config.log config.status

Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	cd $(top_builddir) \
	  && CONFIG_FILES=$@ CONFIG_HEADERS= $(SHELL) ./config.status

################
runtest: $(TSTROOT) $(TSTTOP) $(NPL_TST) $(NPUTIL_TST) $(NPTCL_TST) $(NPTK_TST)
	LD_LIBRARY_PATH=`pwd`:$(LD_LIBRARY_PATH); export LD_LIBRARY_PATH; \
	TCL_PLUGIN_DIR=`pwd`/$(TSTROOT); export TCL_PLUGIN_DIR; \
	./$(TCLSHP)

$(NSP_LIB_FILE): $(POWBINDIR) $(FITSTCLBINDIR) $(CFITSIOBINDIR) $(OBJS)
	@echo "Linking the fat library (tcl+tk+plugin objects)..."
	@echo "  { if you get an error (eventually at netscape runtime!),"
	@echo "    check the values of :"
	@echo "         SHLIB_LD       =$(SHLIB_LD)"
	@echo "    and  LD_SEARCH_FLAGS=$(LD_SEARCH_FLAGS)"
	@echo "    and  SHLIB_LD_LIBS  =$(SHLIB_LD_LIBS) }"
	@$(SHLIB_LD) $(OBJS) -o $(NSP_LIB_FILE) \
		$(LD_SEARCH_FLAGS) $(SHLIB_LD_LIBS)

staging:
	@if test "$(DISTRIB)" = "unknown" ; then \
	  echo " *** Please give the DISTRIB argument, like :";\
	  echo "     make staging DISTRIB=sparc-solaris25";\
	  echo "          or =sparc-sunos4, x86-linux2, x86-solaris25..."; \
	  false ;\
	fi
	-$(MKDIR) $(STAGEDIR)
	$(MAKE) install INST_TOP=$(STAGEDIR) STAGING=1 DISTRIB=$(DISTRIB)
	@echo "### Install scripts staging..."	
	$(INSTALL_PROGRAM) $(TOP_DIR)/installer/install.sh $(STAGEDIR)
	$(INSTALL_DATA) $(TOP_DIR)/doc/INSTALL.unix $(STAGEDIR)/README
	-$(RM) -rf $(STAGEDIR)/installer
	$(MKDIR) $(STAGEDIR)/installer
	@for f in $(TOP_DIR)/installer/*.tcl; do \
		echo "Installing $$f in $(STAGEDIR)/installer"; \
		$(INSTALL_DATA) $$f $(STAGEDIR)/installer ; \
	done ;
	echo $(VERSION) > $(STAGEDIR)/tclplug/plug-version
	echo @NPTCL_PATCH_LEVEL@ > $(STAGEDIR)/tclplug/plug-patchlevel
	echo @TCL_VERSION@ > $(STAGEDIR)/tclplug/tcl-version
	echo $(TCLSHP) > $(STAGEDIR)/tclplug/tclshp-name
	echo $(DISTRIB) > $(STAGEDIR)/tclplug/plug-distrib
	@echo "### Staging area $(STAGEDIR)/ built; making archive"
	tar cf -  $(STAGEDIR) | gzip -9 > $(STAGEFILE)
	@echo "### Created $(STAGEFILE)"

AUTOCONF	= autoconf
GTAR		= gtar

# distclean is going to remove the Makefile and everything
# we save config.status to re-create it
# Nb: we would not need to do distclean before dist
#     if everybody was using a sub directory to build...
distsave:
	-mkdir save
	cp -f config.status save/

dist: distsave distclean sdist
	cp save/config.status .
	sh ./config.status

# the "sdist" target does the real job and can be used
# when your build dir is outside the tree
sdist:
	@echo "### Reminder: you must have done make alldist"
	@echo "### in Tcl and Tk before doing distributions on the plugin"
	@echo "ignore 'cp: xxx: is a directory' errors"
	rm -rf $(DISTDIR1)
	( cd $(TOP_DIR)/unix ; $(AUTOCONF) )
	-@for i in "" generic unix win win/res mac plugin library safetcl \
		config doc tests installer tools ; \
	do \
	  echo "making $(DISTDIR2)/$$i"; \
	  mkdir -p $(DISTDIR2)/$$i;\
	  cp `ls -d1 $(TOP_DIR)/$$i/*|egrep -v "(SCCS|TAGS|~|,|#|%|core|\.l?o)"` $(DISTDIR2)/$$i;\
	done;
	cp $(DISTDIR2)/README $(DISTDIR1)
	cp $(DISTDIR2)/changes $(DISTDIR2)/doc/
	chmod -R ug+rw,o+r $(DISTDIR1)
	chmod 775 $(DISTDIR2)/unix/configure
	chmod 775 $(DISTDIR2)/unix/install-sh
	(cd $(DISTDIR1) ; $(GTAR) xvfz ../tcl@TCLTK_MIN_VERSION@.tar.gz ; mv tcl@TCLTK_MIN_VERSION@ tcl@TCL_VERSION@)
	(cd $(DISTDIR1) ; $(GTAR) xvfz ../tk@TCLTK_MIN_VERSION@.tar.gz ; mv tk@TCLTK_MIN_VERSION@ tk@TCL_VERSION@)


alldist: dist dgz

salldist: sdist dgz

dgz:
	(cd $(DISTDIRTOP); $(RM) $(DISTRIB_SRC).tar.gz ; $(GTAR) cvfz $(DISTRIB_SRC).tar.gz $(DISTDIRNAME))
	(cd $(DISTDIRTOP); $(RM) $(DISTRIB_SRC).zip; zip -r9 $(DISTRIB_SRC).zip $(DISTDIRNAME))
	@echo "### $(DISTRIB_SRC).tar.gz and .zip created."

.PHONY: all binaries clean depend distclean doc install libraries test

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:

# DO NOT DELETE THIS LINE -- make depend depends on it.
