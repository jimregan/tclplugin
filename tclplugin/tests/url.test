# url.test --
#
# This file contains a collection of tests for the url package
# utility functions.
#
# Sourcing this file into Tcl runs the tests and generates output for
# errors.  No output means no errors were found.
#
# In order for these tests to run, the "url" tcl package must be on the
# auto_path or have been loaded already.
#
# CONTACT:		sunscript-plugin@sunscript.sun.com
#
# AUTHORS:		Jacob Levy			Laurent Demailly
#			jyl@eng.sun.com			demailly@eng.sun.com
#			jyl@tcl-tk.com			L@demailly.com
#
# Please contact us directly for questions, comments and enhancements.
#
# Copyright (c) 1996-1997 Sun Microsystems, Inc.
# Copyright (c) 2000 by Scriptics Corporation.
#
# See the file "license.terms" for information on usage and redistribution
# of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
# SCCS: @(#) url.test 1.8 97/09/26 07:03:01
# RCS:  @(#) $Id$

if {[string compare test [info procs test]] == 1} then {source defs}

package require url 1.0;

test url-1.1 {url parse} {
    set p [::url::parse http://foo.bar.com/~blah/]
    list $p [eval ::url::format $p]
} {{http foo.bar.com 80 ~blah/ {}} http://foo.bar.com:80/~blah/}

test url-1.2 {url parse} {
    set p [::url::parse HTTP://foo.BAR.com/~blAH]
    list $p [eval ::url::format $p]
} {{http foo.bar.com 80 ~blAH {}} http://foo.bar.com:80/~blAH}

test url-1.3 {url parse} {
    set p [::url::parse HTTP://foo.bar.com:78/~blah/i.html#blah]
    list $p [eval ::url::format $p]
} {{http foo.bar.com 78 ~blah/i.html #blah} http://foo.bar.com:78/~blah/i.html#blah}

test url-1.3 {url parse} {
    set p [::url::parse http://foo.bar.com]
    list $p [eval ::url::format $p]
} {{http foo.bar.com 80 {} {}} http://foo.bar.com:80/}

test url-1.4 {url parse} {
    set p [::url::parse http://foo.bar.com:12345]
    list $p [eval ::url::format $p]
} {{http foo.bar.com 12345 {} {}} http://foo.bar.com:12345/}


test url-2.1 {url parse} {
    set p [::url::parse mailTO:foo@bAR.com]
    list $p [eval ::url::format $p]
} {{mailto {} 25 foo@bAR.com {}} mailto:foo@bAR.com}

test url-3.1 {url join} {
    ::url::join http://foo.bar.com http://blah.blih.com
} http://blah.blih.com:80/

test url-3.2 {url join} {
    ::url::join http://foo.bar.com/blah/blih foo/test.html
} http://foo.bar.com:80/blah/foo/test.html

test url-3.3 {url join} {
    ::url::join http://foo.bar.com/blah/ foo/test.html
} http://foo.bar.com:80/blah/foo/test.html

test url-3.4 {url join} {
    ::url::join http://foo.bar.com/blah foo/test.html
} http://foo.bar.com:80/foo/test.html

test url-3.5 {url join} {
    ::url::join http://foo.bar.com/blah/blih/a.b ../foo/test.html
} http://foo.bar.com:80/blah/foo/test.html

test url-3.6 {url join} {
    ::url::join http://foo.bar.com/blah/blih/a.b /foo/test.html
} http://foo.bar.com:80/foo/test.html

test url-3.7 {url join} {
    ::url::join http://foo.bar.com/blah/blih/a.b bar/../test.html
} http://foo.bar.com:80/blah/blih/test.html

test url-3.8 {url join} {
    ::url::join http://foo.bar.com/blah/blih/a.b bar/../foo2//root/test.html
} http://foo.bar.com:80/root/test.html

test url-4.1 {file url} {
    ::url::join file:/blah/blih ../../../../test.html
} {file:/test.html}

test url-4.2 {file url} {
    ::url::join file://some.host/blah/blih ../../../../test.html
} {file://some.host:21/test.html}


test url-4.3 {file url} {
    ::url::join file://some.host:2048/blah/blih bar/test.html#what
} {file://some.host:2048/blah/bar/test.html#what}


test url-4.4 {buggy file url that we want to support anyway} {
   ::url::join file:///foo/bar/ tutu#whatever
} {file:/foo/bar/tutu#whatever}

test url-4.5 {buggy file url that we want to support anyway} {
   ::url::join file://////foo/bar/ tutu#whatever
} {file:/foo/bar/tutu#whatever}

test url-5.1 {relative join with just a key} {
    ::url::join http://foo.com/bar #blah
} {http://foo.com:80/bar#blah}

test url-5.2 {relative join with empty url} {
    ::url::join http://foo.com/bar/blah {}
} {http://foo.com:80/bar/}

test url-5.3 {relative join with empty url} {
    ::url::join http://foo.com/bar/ {}
} {http://foo.com:80/bar/}

test url-5.4 {relative join with empty url} {
    ::url::join http://foo.com/ {}
} {http://foo.com:80/}


test url-6.1 {relative join with small ..} {
    ::url::join http://foo.com/bar1/bar2/bar3 ..
} {http://foo.com:80/bar1/}

test url-6.2 {relative join with small ..} {
    ::url::join http://foo.com/bar1/bar2/bar3/bar4 ../
} {http://foo.com:80/bar1/bar2/}

test url-6.3 {relative join with small ..} {
    ::url::join http://foo.com/bar1/bar2 ..
} {http://foo.com:80/}

test url-6.4 {relative join with small ..} {
    ::url::join http://foo.com/ ../
} {http://foo.com:80/}

test url-6.5 {relative join with trailing ..} {
    ::url::join http://foo.com/bar1/bar2 bar3/bar4/..
} {http://foo.com:80/bar1/bar3/}

test url-7.1 {relative join with trailing /} {
    ::url::join http://foo.com/bar1/bar2/bar3/bar4 foo/
} {http://foo.com:80/bar1/bar2/bar3/foo/}

test url-7.2 {relative join with trailing /} {
    ::url::join http://foo.com/bar1/bar2/bar3/bar4 ./
} {http://foo.com:80/bar1/bar2/bar3/}

test url8.1 {canonic url} {
    ::url::canonic http://foo.com
} {http://foo.com:80/}
