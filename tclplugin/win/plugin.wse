  Patch Flags=0000000000001001
  Patch Threshold=85
  Patch Memory=4000
  EXE Filename=tclplug30a1.exe
end
item: Display Graphic
  Pathname=logo.bmp
  X Position=16384
  Y Position=16384
  Flags=0000000000000010
end
item: Check Configuration
  Message=The Tcl Plug-in only supports Window 98, NT 4, 2000 and XP.
  Title=Unable To Install
  Flags=01011010
end
item: Set Variable
  Variable=APPTITLE
  Value=Tcl Plugin 3.0a1 for Windows
end
item: Display Message
  Title=Welcome!
  Text=This program will install the Tcl Plugin 3.0a1 for Netscape Navigator and Microsoft Internet Explorer onto your computer. The plugin works with Netscape Navigator 4.x and with Microsoft Internet Explorer 4.0, 5.0 and 5.5sp1. Press the OK button to start the installation. You can press the Cancel button if you do not want to install this software.
end
item: Set Variable
  Variable=GROUP
  Value=Tcl
end
item: Set Variable
  Variable=MAINDIR
  Value=C:\TclPlug\
end
item: Browse for Directory
  Variable=MAINDIR
  Flags=1
  Window Name=Select Destination Directory
  Prompt Description=The Tcl Plug-in libraries will be installed into the following directory. The library contains scripts that are used by the plug-in for initialization and runtime interaction.
  Prompt Description=
  Prompt Description=If you would like to install it into a different directory/drive, use the browse list below.
  Prompt Name=Destination Directory:
  Default Value=%MAINDIR%
  Flags=00000001
end
item: Check Disk Space
end
item: Set Variable
  Variable=MAINDIR
  Value=%MAINDIR%
  Flags=00010100
end
item: Set Variable
  Variable=VERDIR
  Value=%MAINDIR%\3.0
end
item: Set Variable
  Variable=BINDIR
  Value=%VERDIR%\bin
end
item: Set Variable
