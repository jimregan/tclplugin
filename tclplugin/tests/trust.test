# trust.test --
#
# This file contains a collection of tests for the trust modules
# utility functions.
# Sourcing this file into Tcl runs the tests and generates output for
# errors.  No output means no errors were found.
#
# In order for these tests to run, the trust tcl library must be on the
# auto_path or have been loaded already.
#
# Copyright (c) 1997 by Sun Microsystems, Inc.  All rights reserved.
#
# SCCS: @(#) trust.test 1.4 97/09/26 07:03:46
#

if {[string compare test [info procs test]] == 1} then {source defs}

test trust_translate-1.1 {translate expressions:simple} {
	trust_translate_expr "a b c"
} {[a]&&[b]&&[c]}

test trust_translate-1.2 {translate expressions:simple} {
	trust_translate_expr {a bsdfg
      cgh}
} {[a]&&[bsdfg]&&[cgh]}

test trust_translate-1.3 {translate expressions:simple + prefix} {
	trust_translate_expr "a b c" trust_
} {[trust_a]&&[trust_b]&&[trust_c]}

test trust_translate-1.4 {translate expressions:simple + prefix + suffix} {
	trust_translate_expr "a b c" trust_ { $val}
} {[trust_a $val]&&[trust_b $val]&&[trust_c $val]}

test trust_translate-1.5 {translate expression:medium + prefix + suffix} {
	trust_translate_expr "(a && b) || c" trust_ { $val}
} {([trust_a $val] && [trust_b $val]) || [trust_c $val]}


test trust_translate-1.6 {translate expressions:complex} {
	trust_translate_expr {(a96-3>4) blah || last}
} {([a96]-3>4)&&[blah] || [last]}

test trust_translate-2.1 {translate expression + eval check} {
	set path {}
	proc foo_a {val} {upvar path p;append p a;return $val}
	proc foo_b {val} {upvar path p;append p b;return [expr !$val]}
	set v 1;
	list [expr [trust_translate_expr "(b || a)" foo_ { $v}]] $path;
} {1 ba}

test trust_translate-2.2 {translate expression + eval check} {
	set path {}
	proc foo_a {val} {upvar path p;append p a;return $val}
	proc foo_b {val} {upvar path p;append p b;return [expr !$val]}
	set v 0;
	list [expr [trust_translate_expr "(a && b)" foo_ { $v}]] $path;
} {0 a}

