/*
 * Tcl Plugin version identifiers
 * (the 3 strings are computed from the 4 internal numbers)
 */
#define NPTCL_VERSION "@NPTCL_VERSION@"
#define NPTCL_PATCH_LEVEL "@NPTCL_PATCH_LEVEL@"
#define NPTCL_INTERNAL_VERSION "@NPTCL_INTERNAL_VERSION@"

#define NPTCL_MAJOR_VERSION @NPTCL_MAJOR_VERSION@
#define NPTCL_MINOR_VERSION @NPTCL_MINOR_VERSION@
#define NPTCL_RELEASE_LEVEL @NPTCL_RELEASE_LEVEL@
#define NPTCL_RELEASE_SERIAL @NPTCL_RELEASE_SERIAL@

#endif	/* NP_CONFIG */
